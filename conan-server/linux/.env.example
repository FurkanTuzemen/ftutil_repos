# Copy to .env and fill in, or just run bootstrap.sh - it generates a .env
# with random secrets on first run. NEVER commit .env: it holds credentials.

# Users allowed to authenticate: "name:password" pairs separated by ";".
CONAN_SERVER_USERS=ci:changeme

# Comma-separated user names with write (upload) access.
# Empty = every user from CONAN_SERVER_USERS.
CONAN_WRITE_USERS=ci

# Comma-separated user names with read (download) access.
# "?" = any authenticated user (the default), "*" = anonymous too.
CONAN_READ_USERS=?

# Long random strings (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`).
# jwt signs login tokens, updown signs the upload/download URLs.
CONAN_JWT_SECRET=change-me-64-hex-chars
CONAN_UPDOWN_SECRET=change-me-64-hex-chars

# Hostname or IP that CLIENTS use to reach this server - it is baked into the
# upload/download URLs the server hands out. Use the LAN IP, or the Tailscale
# name/IP once the Pi is on a tailnet and CI connects through it.
CONAN_PUBLIC_HOSTNAME=192.168.1.100
CONAN_PUBLIC_PORT=9300

# Where packages are stored on the host (the external disk mount).
CONAN_DATA_DIR=/mnt/expansion/conan-server-data

# Toolchain pin - bootstrap.sh overwrites these on every run with the versions
# from FurkanTuzemen/ConanAutomation (ftdeps/model.py), so the server always
# matches the Conan the automation uses. Edit by hand only for a one-off test;
# the next bootstrap run re-syncs them.
CONAN_SERVER_VERSION=2.7.1
CONAN_PYTHON_VERSION=3.11
