# Server configuration + secrets. bootstrap.sh generates a real .env
# (random secrets, chmod 600) on first run - you normally never write this by
# hand. NEVER commit .env.

# ---- Users / permissions ----------------------------------------------------
# Users allowed to authenticate: "name:password" pairs separated by ";".
CONAN_SERVER_USERS=ci:changeme
# Comma-separated user names with write (upload) access.
# Empty = every user from CONAN_SERVER_USERS.
CONAN_WRITE_USERS=ci
# Comma-separated user names with read (download) access.
# "?" = any authenticated user (default), "*" = anonymous too.
CONAN_READ_USERS=?

# ---- Secrets ----------------------------------------------------------------
# Long random strings: python3 -c "import secrets; print(secrets.token_hex(32))"
# jwt signs login tokens, updown signs the upload/download URLs.
CONAN_JWT_SECRET=change-me-64-hex-chars
CONAN_UPDOWN_SECRET=change-me-64-hex-chars

# ---- Network ----------------------------------------------------------------
# Hostname/IP that CLIENTS use to reach the server. It is baked into the
# upload/download URLs the server hands out, so it must be reachable from every
# client (dev machines, CI runners). Use the Tailscale IP or MagicDNS name.
CONAN_PUBLIC_HOSTNAME=100.x.y.z
CONAN_PUBLIC_PORT=9300

# ---- Storage ----------------------------------------------------------------
# "none" (default) = packages on the root filesystem (ext4 SD card on the Pi).
# Or the partition UUID of a dedicated package disk (sudo blkid); bootstrap
# then adds it to /etc/fstab and mounts it. Prefer ext4 - NTFS goes "dirty"
# after an unclean shutdown and Linux then refuses to mount it.
CONAN_DISK_UUID=none
# Only with a dedicated disk:
# CONAN_DISK_FSTYPE=ext4
# CONAN_MOUNT_POINT=/mnt/conan
# Where packages live on the host; bind-mounted to /data in the container.
CONAN_DATA_DIR=/srv/conan-server-data

# ---- Versions (copied from ../versions.env by bootstrap - edit that file) -------
CONAN_SERVER_VERSION=2.7.1
CONAN_PYTHON_VERSION=3.11

# ---- Optional ---------------------------------------------------------------
# Only for a second, throwaway instance side by side with the real one -
# change BOTH, or compose commands in the test copy act on the real server.
# CONAN_CONTAINER_NAME=conan-server
# COMPOSE_PROJECT_NAME=conan-server
