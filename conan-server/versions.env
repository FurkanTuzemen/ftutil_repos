# Single source of truth for what the server runs. Committed.
#
# These MUST match the toolchain pinned in FurkanTuzemen/ConanAutomation
# (ftdeps/model.py: conan_version / python_version) so the server always
# speaks the same Conan version as the automation and CI. linux/bootstrap.sh
# re-reads that pin on every run and rewrites this file if it drifted - commit
# the change when that happens.
CONAN_SERVER_VERSION=2.7.1
CONAN_PYTHON_VERSION=3.11
