[Unit]
Description=Internet failover (ethernet first, then a priority list of WiFi networks)
Documentation=file:/etc/net-failover/networks.conf
Wants=NetworkManager.service
After=NetworkManager.service network.target
PartOf=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/net-failover --daemon
Restart=always
RestartSec=5

# Needs root: SO_BINDTODEVICE for per-interface probes, plus NM control.
User=root
NoNewPrivileges=false

# Modest hardening — the daemon only talks to NetworkManager and the network.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/net-failover /etc/NetworkManager
RuntimeDirectory=net-failover
RuntimeDirectoryMode=0755
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
